# Copiar a .env (docker compose lo lee automáticamente). Todas son opcionales.

# TomTom (02 - Metadata/etl_tomtom_trafico.py)
TOMTOM_API_KEY=
# Mapillary (02 - Metadata/extract_luminarias_mapillary.py)
MAPILLARY_TOKEN=

# Gurobi: sin estas variables se usa la licencia limitada de pip (2000 variables/restricciones),
# suficiente para este proyecto. Con una licencia académica WLS (gratis con correo universitario,
# https://www.gurobi.com/academia/academic-program-and-licenses/) se quita el límite.
GRB_WLSACCESSID=
GRB_WLSSECRET=
GRB_LICENSEID=

# Amenazas simuladas al correr el ETL (alternativa a simularlas desde la web): "lon,lat,radio_m"
LLUVIA_SIMULADA=
VIENTO_SIMULADO=
